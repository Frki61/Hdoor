local function runCollectionWave()
	if State.isCollectingNow then return end
	State.isCollectingNow = true

	task.spawn(function()
		local okRun = pcall(function()
			local _, initialHrp = getAliveCharacter()
			local initialStartCFrame = initialHrp and initialHrp.CFrame or nil

			local doors = getCollectableDoors()
			if #doors == 0 then
				safeSetText(statusSubLabel, "Status: No Available Doors")
				return
			end

			local _, hrp = getAliveCharacter()
			if not hrp then return end

			local route, totalDist = computeOptimalRoute(hrp.Position, doors)
			if #route == 0 then return end

			local dynamicSpeed = calculateRequiredSpeed(totalDist, State.collectionBudget)

			safeSetText(timerLabel, string.format("⚡ Budget: %ds | Doors: %d", State.collectionBudget, #route), Color3.fromRGB(255, 215, 0))

			local routeIndex = 1
			while State.isAutoCollectActive and routeIndex <= #route do
				while State.isAutoCollectActive and not getAliveCharacter() do
					clearRouteBeam()
					cleanupPhysics()
					safeSetText(statusSubLabel, "Status: Waiting for Respawn...")
					task.wait(0.5)
				end
				if not State.isAutoCollectActive then break end

				local node = route[routeIndex]
				local door = node.door
				local doorPart = node.part or findBestDoorPart(door)

				if door and doorPart and doorNeedsCollection(door) then
					safeSetText(statusSubLabel, string.format("Door %d/%d [Budget: %ds | Spd: %d]", routeIndex, #route, State.collectionBudget, math.floor(dynamicSpeed)))
					local _, liveHrp = getAliveCharacter()
					if liveHrp then updateRouteBeam(liveHrp, doorPart) end

					local isJitter = isDoorMovingOrJittering(doorPart)
					if isJitter then
						attachAndAttackDoor(door, doorPart, function(m) safeSetText(statusSubLabel, m) end)
						markDoorAttempted(door)
					else
						local arrived = false
						if State.movementMode == "FLY" then
							arrived = navigateBestPathV58(door, doorPart, dynamicSpeed)
						else
							arrived = walkToTarget(door, doorPart)
						end

						if arrived and State.isAutoCollectActive then
							interactWithDoorOnGround(door, doorPart, statusSubLabel)
						end
					end
				end

				routeIndex = routeIndex + 1
				task.wait(0.02)
			end

			clearRouteBeam()
			updateWatchdog()

			if State.isAutoCollectActive and State.movementMode == "FLY" and initialStartCFrame then
				safeSetText(statusSubLabel, "Status: Returning to Start...", Color3.fromRGB(130, 220, 255))
				flyBackToStart(initialStartCFrame, dynamicSpeed)
			end

			cleanupPhysics()
			local _, _, endHum = getAliveCharacter()
			if endHum then endHum.WalkSpeed = State.originalWalkSpeed end

			safeSetText(statusSubLabel, "Status: Wave Completed in Budget! ✅", Color3.fromRGB(120, 255, 140))
		end)

		if not okRun then
			clearRouteBeam()
			cleanupPhysics()
		end
		State.isCollectingNow = false
	end)
end

