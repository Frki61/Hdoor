local cachedCandyValueObj = nil
local lastCandyScanClock = 0

local function parseCandyNumber(raw)
	if typeof(raw) == "number" then
		return math.max(0, math.floor(raw))
	end
	if typeof(raw) == "string" then
		local clean = string.gsub(raw, ",", "")
		local numPart, suffix = string.match(clean, "([%d%.]+)%s*([kKmMbB]?)")
		local n = tonumber(numPart)
		if n then
			local s = string.lower(suffix or "")
			if s == "k" then n = n * 1000
			elseif s == "m" then n = n * 1000000
			elseif s == "b" then n = n * 1000000000 end
			return math.floor(n)
		end
		local digitsOnly = string.gsub(clean, "[^%d]", "")
		if digitsOnly ~= "" then
			return tonumber(digitsOnly) or 0
		end
	end
	return nil
end

local function readCandyFromInstance(inst)
	if not inst or not inst.Parent then return nil end
	if inst:IsA("IntValue") or inst:IsA("NumberValue") or inst:IsA("StringValue") then
		return parseCandyNumber(inst.Value)
	elseif inst:IsA("TextLabel") or inst:IsA("TextButton") then
		return parseCandyNumber(inst.Text)
	end
	return nil
end

local function getMyCandyCount()
	-- 1. Instant O(1) read if reference is already cached
	if cachedCandyValueObj and cachedCandyValueObj.Parent then
		local val = readCandyFromInstance(cachedCandyValueObj)
		if val ~= nil then return val end
	end
	cachedCandyValueObj = nil

	-- Throttle deep fallback scans to at most once every 1.5 seconds (prevents executor crash)
	local now = os.clock()
	if (now - lastCandyScanClock) < 1.5 then
		return 0
	end
	lastCandyScanClock = now

	-- 2. Direct Player Attributes check (O(1))
	local okAttr, attrs = pcall(function() return localPlayer:GetAttributes() end)
	if okAttr and attrs then
		for attrName, attrVal in pairs(attrs) do
			if string.find(string.lower(attrName), "cand") then
				local parsed = parseCandyNumber(attrVal)
				if parsed ~= nil then return parsed end
			end
		end
	end

	-- 3. Direct Shallow Scan of leaderstats / Stats / Data
	for _, folderName in ipairs({"leaderstats", "Stats", "Data", "PlayerData", "Values"}) do
		local folder = localPlayer:FindFirstChild(folderName)
		if folder then
			for _, child in ipairs(folder:GetChildren()) do
				if string.find(string.lower(child.Name), "cand") then
					local val = readCandyFromInstance(child)
					if val ~= nil then
						cachedCandyValueObj = child
						return val
					end
				end
			end
		end
	end

	-- 4. Targeted PlayerGui.Candies lookup (safe, non-recursive first)
	local pGui = localPlayer:FindFirstChild("PlayerGui")
	if pGui then
		local candiesGui = pGui:FindFirstChild("Candies")
		if candiesGui then
			for _, targetName in ipairs({"Amount", "Value", "Count", "CandyAmount", "Balance"}) do
				local obj = candiesGui:FindFirstChild(targetName, true)
				local val = readCandyFromInstance(obj)
				if val ~= nil then
					cachedCandyValueObj = obj
					return val
				end
			end
			for _, desc in ipairs(candiesGui:GetDescendants()) do
				if desc:IsA("TextLabel") and desc.Text ~= "" then
					local val = readCandyFromInstance(desc)
					if val ~= nil then
						cachedCandyValueObj = desc
						return val
					end
				end
			end
		end
	end

	return 0
end

