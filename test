local function interactWithDoorOnGround(door, targetPart, statusLabel)
	if not door or not door.Parent or not targetPart or not targetPart.Parent then return false end
	local _, hrp, hum = getAliveCharacter()
	if not hrp or not hum then return false end

	hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(targetPart.Position.X, hrp.Position.Y, targetPart.Position.Z))
	task.wait(0.03)

	aimCameraAtPart(targetPart)

	local prompts = getDoorPrompts(door)
	for _, p in ipairs(prompts) do
		preparePrompt(p)
		if typeof(fireproximityprompt) == "function" then
			pcall(fireproximityprompt, p)
			pcall(fireproximityprompt, p, 0)
			pcall(fireproximityprompt, p, 0, true)
		end
	end

	for _, desc in ipairs(door:GetDescendants()) do
		if desc:IsA("ClickDetector") and typeof(fireclickdetector) == "function" then
			pcall(fireclickdetector, desc)
		end
	end

	pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game) end)
	for _, p in ipairs(prompts) do
		if p and p.Parent then pcall(function() p:InputHoldBegin() end) end
	end

	local holdDuration = State.useSmartHoldMode and 0.40 or 0.08
	local holdStart = os.clock()
	while (os.clock() - holdStart) < holdDuration do
		aimCameraAtPart(targetPart)
		RunService.Heartbeat:Wait()
	end

	for _, p in ipairs(prompts) do
		if p and p.Parent then
			pcall(function() p:InputHoldEnd() end)
			if typeof(fireproximityprompt) == "function" then
				pcall(fireproximityprompt, p)
			end
		end
	end
	pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)

	markDoorAttempted(door)
	if statusLabel then safeSetText(statusLabel, "✅ Collected! Resuming...") end
	return true
end

