local function getEffectsFolder()
	return Workspace:FindFirstChild("Effects")
end

local function isValidDoorRoot(obj)
	if not obj or obj.Name ~= "HalloweenDoor" then return false end
	if not obj:IsDescendantOf(Workspace) then return false end
	if localPlayer.Character and obj:IsDescendantOf(localPlayer.Character) then return false end
	if obj:IsA("Model") then return true end
	if obj:IsA("BasePart") and (not obj.Parent or obj.Parent.Name ~= "HalloweenDoor") then return true end
	return false
end

local function getDoorRootFromDescendant(instance)
	local current = instance
	while current and current ~= Workspace do
		if isValidDoorRoot(current) then return current end
		current = current.Parent
	end
	return nil
end

local function getDoorPrompts(door)
	local prompts = {}
	if not door or not door.Parent then return prompts end
	if door:IsA("ProximityPrompt") then table.insert(prompts, door) end
	for _, desc in ipairs(door:GetDescendants()) do
		if desc:IsA("ProximityPrompt") then
			if originalHoldDurations[desc] == nil then originalHoldDurations[desc] = desc.HoldDuration end
			table.insert(prompts, desc)
		end
	end
	return prompts
end

local function findBestDoorPart(target)
	if not target or not target.Parent then return nil end
	for _, p in ipairs(getDoorPrompts(target)) do
		local parent = p.Parent
		if parent then
			if parent:IsA("BasePart") then return parent end
			if parent:IsA("Attachment") and parent.Parent and parent.Parent:IsA("BasePart") then return parent.Parent end
			if parent:IsA("Model") and parent.PrimaryPart then return parent.PrimaryPart end
		end
	end
	if target:IsA("BasePart") then return target end
	if target:IsA("Model") then
		if target.PrimaryPart then return target.PrimaryPart end
		local d = target:FindFirstChild("Door", true)
		if d and d:IsA("BasePart") then return d end
		local pk = target:FindFirstChild("Pumpkin", true)
		if pk and pk:IsA("BasePart") then return pk end
		return target:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function extractTimerFromText(text)
	if not text or typeof(text) ~= "string" then return nil, nil end
	local clean = string.gsub(text, "%s+", " ")
	local m, s = string.match(clean, "(%d+):(%d%d)")
	if m and s then
		local totalSec = (tonumber(m) * 60) + tonumber(s)
		return totalSec, string.format("%02d:%02d", tonumber(m), tonumber(s))
	end
	local secOnly = string.match(clean, "(%d+)%s*s") or string.match(clean, "(%d+)%s*sec")
	if secOnly then
		local n = tonumber(secOnly)
		return n, string.format("%02d:%02d", math.floor(n/60), n%60)
	end
	local lower = string.lower(clean)
	if string.find(lower, "ready") or string.find(lower, "open") or clean == "0" then
		return 0, "00:00"
	end
	local justNum = string.match(clean, "^(%d+)$")
	if justNum then
		local n = tonumber(justNum)
		if n <= 600 then return n, string.format("%02d:%02d", math.floor(n/60), n%60) end
	end
	return nil, nil
end

local function getDoorLiveTimer(door)
	if not door or not door.Parent then return nil, nil, nil end
	local pumpkin = door:FindFirstChild("Pumpkin", true)
	if pumpkin then
		for _, d in ipairs(pumpkin:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text and d.Text ~= "" then
				local sec, fmt = extractTimerFromText(d.Text)
				if sec ~= nil then return sec, fmt, d end
			end
		end
	end
	for _, d in ipairs(door:GetDescendants()) do
		if d:IsA("TextLabel") and d.Text and d.Text ~= "" then
			local sec, fmt = extractTimerFromText(d.Text)
			if sec ~= nil then return sec, fmt, d end
		elseif d:IsA("ProximityPrompt") then
			local sec, fmt = extractTimerFromText(d.ActionText)
			if sec ~= nil then return sec, fmt, nil end
			sec, fmt = extractTimerFromText(d.ObjectText)
			if sec ~= nil then return sec, fmt, nil end
		end
	end
	return nil, nil, nil
end

local function markDoorAttempted(door)
	if door then pendingVerification[door] = os.clock() end
end

local function updateWatchdog()
	local now = os.clock()
	for door, t in pairs(confirmedCollected) do
		if (now - t) > Config.DOOR_COOLDOWN_SEC or not door.Parent then confirmedCollected[door] = nil end
	end
	for door, attemptedTime in pairs(pendingVerification) do
		local elapsed = now - attemptedTime
		if not door or not door.Parent or not door:IsDescendantOf(Workspace) then
			pendingVerification[door] = nil
			confirmedCollected[door] = now
		elseif elapsed >= Config.DOOR_RETRY_WATCHDOG_SEC then
			local prompts = getDoorPrompts(door)
			if #prompts > 0 then
				pendingVerification[door] = nil
				confirmedCollected[door] = nil
			else
				pendingVerification[door] = nil
				confirmedCollected[door] = now
			end
		end
	end
end

local function doorNeedsCollection(door)
	if not door or not door.Parent or not door:IsDescendantOf(Workspace) then return false end
	if confirmedCollected[door] then return false end
	if pendingVerification[door] and (os.clock() - pendingVerification[door]) < Config.DOOR_RETRY_WATCHDOG_SEC then
		return false
	end
	return #getDoorPrompts(door) > 0
end

local function getActiveDoors()
	local doors = {}
	local seen = {}
	local effects = getEffectsFolder()
	if effects then
		for _, obj in ipairs(effects:GetChildren()) do
			if isValidDoorRoot(obj) and not seen[obj] then
				seen[obj] = true
				table.insert(doors, obj)
			elseif obj:IsA("Folder") or obj:IsA("Model") then
				for _, sub in ipairs(obj:GetChildren()) do
					if isValidDoorRoot(sub) and not seen[sub] then
						seen[sub] = true
						table.insert(doors, sub)
					end
				end
			end
		end
	end
	if #doors == 0 then
		for _, obj in ipairs(Workspace:GetChildren()) do
			if isValidDoorRoot(obj) and not seen[obj] then
				seen[obj] = true
				table.insert(doors, obj)
			end
		end
		for _, fn in ipairs({"Map", "Debris", "Halloween", "Spawns"}) do
			local f = Workspace:FindFirstChild(fn)
			if f then
				for _, obj in ipairs(f:GetChildren()) do
					if isValidDoorRoot(obj) and not seen[obj] then
						seen[obj] = true
						table.insert(doors, obj)
					end
				end
			end
		end
	end
	return doors
end

local function getCollectableDoors(prefetchedDoors)
	updateWatchdog()
	local doors = prefetchedDoors or getActiveDoors()
	local list = {}
	for _, door in ipairs(doors) do
		if doorNeedsCollection(door) then table.insert(list, door) end
	end
	return list
end

