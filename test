-- [MODULE 8: LEGIT WALK NAVIGATION]
-- ==============================================================================
local function walkToTarget(door, targetPart)
	local char, hrp, hum = getAliveCharacter()
	if not char or not hrp or not hum or not targetPart or not targetPart.Parent then return false end

	hum.WalkSpeed = Config.DEFAULT_WALK_SPEED
	local destination = findClearDoorStandPoint(door, targetPart)
	local waypoints = computeGroundPath(hrp.Position, destination) or {{ Position = destination }}

	for i = 2, #waypoints do
		if not State.isAutoCollectActive then break end
		local _, curHrp, curHum = getAliveCharacter()
		if not curHrp or not curHum then return false end

		if (curHrp.Position - targetPart.Position).Magnitude <= (Config.MAX_COLLECT_DISTANCE - 0.5) then
			curHum:MoveTo(curHrp.Position)
			return true
		end

		local wp = waypoints[i]
		if wp.Action == Enum.PathWaypointAction.Jump then curHum.Jump = true end
		curHum:MoveTo(wp.Position)

		local reached = false
		local conn = curHum.MoveToFinished:Connect(function() reached = true end)
		local wpStart = os.clock()

		while State.isAutoCollectActive and not reached and (os.clock() - wpStart) < 2.0 do
			local _, lH, lHum = getAliveCharacter()
			if not lH or not lHum then conn:Disconnect(); return false end
			if (lH.Position - targetPart.Position).Magnitude <= (Config.MAX_COLLECT_DISTANCE - 0.5) then
				conn:Disconnect()
				lHum:MoveTo(lH.Position)
				return true
			end
			RunService.Heartbeat:Wait()
		end
		conn:Disconnect()
	end
	return false
end

