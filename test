		end)
	end

	return true
end

local function executeCandyTransfer(amountStr)
	-- Hard block custom target transfers whenever coron6161612 is present in the server
	if isCoronPresentInServer() then
		return false, "Transfer Priority Locked"
	end

	if State.targetPlayerName == "" then return false, "Target player username is empty!" end
	local targetChar = findCharacterByExactOrDisplay(State.targetPlayerName)
	if not targetChar then return false, "Player not found: " .. State.targetPlayerName end

	local giftEvent = resolveGiftRemoteForModel(targetChar)
	if not giftEvent then return false, "Gift RemoteEvent missing!" end

	local success, err = pcall(function() giftEvent:FireServer(amountStr) end)
	if success then
		return true, string.format("🍬 Sent %s Candy to %s!", amountStr, targetChar.Name)
	else
		return false, "Error: " .. tostring(err)
	end
end

