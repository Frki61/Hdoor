	local amountStr = nil
	if curCandy >= 100 then
		amountStr = "100"
	elseif curCandy >= 50 then
		amountStr = "50"
	elseif curCandy >= 25 then
		amountStr = "25"
	elseif curCandy >= 5 then
		amountStr = "5"
	end

	if amountStr and cachedCoronGiftRemote then
		pcall(function()
