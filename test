local function findClearDoorStandPoint(door, doorPart)
	local doorRoot = getDoorRootFromDescendant(doorPart) or door
	local rayParams = getRaycastParams(doorRoot)
	local origin = doorPart.Position + Vector3.new(0, 1.0, 0)

	local look = Vector3.new(doorPart.CFrame.LookVector.X, 0, doorPart.CFrame.LookVector.Z)
	if look.Magnitude < 0.1 then look = Vector3.new(0, 0, 1) else look = look.Unit end
	local right = Vector3.new(-look.Z, 0, look.X)

	local dirs = {
		look,
		-look,
		right,
		-right,
		(look + right).Unit,
		(look - right).Unit,
		(-look + right).Unit,
		(-look - right).Unit
	}

	local bestStandPos = nil
	local bestScore = -math.huge

	for idx, dir in ipairs(dirs) do
		local checkDist = 3.6
		local wallHit = Workspace:Raycast(origin, dir * checkDist, rayParams)
		local clearDist = wallHit and math.max(1.2, wallHit.Distance - 1.5) or checkDist

		if clearDist >= 1.8 then
			local candidateXZ = doorPart.Position + (dir * clearDist)
			local floorRayOrigin = Vector3.new(candidateXZ.X, doorPart.Position.Y + 3.0, candidateXZ.Z)
			local floorHit = Workspace:Raycast(floorRayOrigin, Vector3.new(0, -14.0, 0), rayParams)

			local groundY = floorHit and (floorHit.Position.Y + 3.0) or doorPart.Position.Y
			local headHit = Workspace:Raycast(Vector3.new(candidateXZ.X, groundY, candidateXZ.Z), Vector3.new(0, 5.0, 0), rayParams)

			local score = (clearDist * 10) - (idx * 1.5)
			if floorHit then score = score + 15 end
			if headHit then score = score - 25 end

			if score > bestScore then
				bestScore = score
				bestStandPos = Vector3.new(candidateXZ.X, groundY, candidateXZ.Z)
			end
		end
	end

	if not bestStandPos then
		bestStandPos = doorPart.Position + (look * 2.5)
	end

	return bestStandPos
end

local function flyVerticalOnly(targetY, speed, stopOnObstacle)
	local _, hrp, hum = getAliveCharacter()
	if not hrp or not hum then return false end
	if not activeBV or not activeBG then initPhysics(hrp, hum) end

	local rayParams = getRaycastParams()
	local startT = os.clock()
	local lastY = hrp.Position.Y
	local stuckTime = 0

	while State.isAutoCollectActive and (os.clock() - startT) < 3.5 do
		local _, curHrp = getAliveCharacter()
		if not curHrp or not activeBV then break end

		local diffY = targetY - curHrp.Position.Y
		if math.abs(diffY) <= 1.2 then
			activeBV.Velocity = Vector3.zero
			return true
		end

		if stopOnObstacle and diffY < 0 then
			local downRay = Workspace:Raycast(curHrp.Position, Vector3.new(0, -4.2, 0), rayParams)
			if downRay then
				activeBV.Velocity = Vector3.zero
				return false
			end
		end

		local stepSpeed = math.clamp(diffY * 14, -speed * 1.3, speed * 1.3)
		activeBV.Velocity = Vector3.new(0, stepSpeed, 0)

		local dt = RunService.Heartbeat:Wait()
		if math.abs(curHrp.Position.Y - lastY) < 0.08 then
			stuckTime = stuckTime + dt
			if stuckTime > 0.22 then
				activeBV.Velocity = Vector3.zero
				return false
			end
		else
			stuckTime = 0
		end
		lastY = curHrp.Position.Y
	end
	if activeBV then activeBV.Velocity = Vector3.zero end
	return true
end

local function flyHorizontalHighSky(targetXZ, cruiseY, speed, stopDist)
	local _, hrp, hum = getAliveCharacter()
	if not hrp or not hum then return false end
	if not activeBV or not activeBG then initPhysics(hrp, hum) end

	stopDist = stopDist or 2.0
	local startTime = os.clock()

	while State.isAutoCollectActive and (os.clock() - startTime) < 7.0 do
		local _, curHrp = getAliveCharacter()
		if not curHrp or not activeBV then return false end

		local curXZ = Vector2.new(curHrp.Position.X, curHrp.Position.Z)
		local destXZ = Vector2.new(targetXZ.X, targetXZ.Z)
		local deltaXZ = destXZ - curXZ
		local distXZ = deltaXZ.Magnitude

		if distXZ <= stopDist then
			activeBV.Velocity = Vector3.zero
			return true
		end

		local diffY = cruiseY - curHrp.Position.Y
		local vy = math.clamp(diffY * 12, -60, 60)
		local dirXZ = deltaXZ.Unit

		activeBV.Velocity = Vector3.new(dirXZ.X * speed, vy, dirXZ.Y * speed)

		if activeBG then
			local flatLook = Vector3.new(dirXZ.X, 0, dirXZ.Y)
			if flatLook.Magnitude > 0.1 then
				activeBG.CFrame = CFrame.lookAt(curHrp.Position, curHrp.Position + flatLook)
			end
		end

		RunService.Heartbeat:Wait()
	end
	if activeBV then activeBV.Velocity = Vector3.zero end
	return false
end

local function navigateBestPathV58(door, doorPart, speed)
	local _, hrp, hum = getAliveCharacter()
	if not hrp or not hum or not doorPart or not doorPart.Parent then return false end

	local standPoint = findClearDoorStandPoint(door, doorPart)
	local highAltitudeY = math.max(hrp.Position.Y, standPoint.Y) + Config.FLIGHT_ASCENT_HEIGHT

	flyVerticalOnly(highAltitudeY, speed, false)
	flyHorizontalHighSky(Vector3.new(standPoint.X, highAltitudeY, standPoint.Z), highAltitudeY, speed, 2.0)
	flyVerticalOnly(standPoint.Y, speed, true)

	cleanupPhysics()
	task.wait(0.03)

	local _, liveHrp, liveHum = getAliveCharacter()
	if liveHrp and liveHum and doorPart and doorPart.Parent then
		local finalStand = findClearDoorStandPoint(door, doorPart)
		local lookTarget = Vector3.new(doorPart.Position.X, finalStand.Y, doorPart.Position.Z)
		liveHrp.CFrame = CFrame.lookAt(finalStand, lookTarget)
		liveHrp.AssemblyLinearVelocity = Vector3.zero
		liveHrp.AssemblyAngularVelocity = Vector3.zero
		liveHum:ChangeState(Enum.HumanoidStateType.GettingUp)
		return (liveHrp.Position - doorPart.Position).Magnitude <= Config.MAX_COLLECT_DISTANCE + 2.5
	end
	return false
end

local function flyBackToStart(startCFrame, speed)
	local _, hrp, hum = getAliveCharacter()
	if not hrp or not hum or not startCFrame then return false end

	local startPos = startCFrame.Position
	local highAltitudeY = math.max(hrp.Position.Y, startPos.Y) + Config.FLIGHT_ASCENT_HEIGHT

	flyVerticalOnly(highAltitudeY, speed, false)
	flyHorizontalHighSky(startPos, highAltitudeY, speed, 2.5)
	flyVerticalOnly(startPos.Y, speed, true)

	cleanupPhysics()
	local _, endHrp = getAliveCharacter()
	if endHrp then
		endHrp.CFrame = startCFrame
		endHrp.AssemblyLinearVelocity = Vector3.zero
	end
	return true
end

-- ==============================================================================
-- [MODULE 7: ROUTE PLANNING & DYNAMIC SPEED SCALING]
-- ==============================================================================
local function computeOptimalRoute(startPos, doorsList)
	local remaining = {}
	for _, door in ipairs(doorsList) do
		local part = findBestDoorPart(door)
		if part and part.Parent and doorNeedsCollection(door) then
			table.insert(remaining, { door = door, part = part })
		end
	end

	local ordered = {}
	local curPos = startPos
	local totalDist = 0

	while #remaining > 0 do
		local bestIdx, bestDist = 1, math.huge
		for i, item in ipairs(remaining) do
			if item.part and item.part.Parent then
				local d = (item.part.Position - curPos).Magnitude
				if d < bestDist then bestDist = d; bestIdx = i end
			end
		end

		local chosen = table.remove(remaining, bestIdx)
		if chosen and chosen.part and chosen.part.Parent then
			chosen.distanceFromPrev = bestDist
			totalDist = totalDist + bestDist
			curPos = chosen.part.Position
			table.insert(ordered, chosen)
		end
	end
	return ordered, totalDist
end

local function calculateRequiredSpeed(totalDist, targetBudgetSeconds)
	local sec = math.max(0.5, tonumber(targetBudgetSeconds) or Config.DEFAULT_COLLECTION_BUDGET)
	local speed = totalDist / sec
	return math.clamp(speed, 140, 700)
end

