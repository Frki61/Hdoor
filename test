_G.HalloweenDoorDebug_Cleanup = function()
	State.isEspActive = false
	State.isPromptActive = false
	State.isAutoCollectActive = false
	State.isCollectingNow = false
	State.isAutoTransferActive = false

	clearRouteBeam()
	cleanupPhysics()

	local _, _, hum = getAliveCharacter()
	if hum then hum.WalkSpeed = State.originalWalkSpeed end

	cleanupDeadESP()

	for _, conns in pairs(promptConnections) do
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	end
	table.clear(promptConnections)

	for _, c in ipairs(globalConnections) do pcall(function() c:Disconnect() end) end
	table.clear(globalConnections)

	if screenGui then pcall(function() screenGui:Destroy() end) end
	_G.HalloweenDoorDebug_Cleanup = nil
end

print("[DEBUG] Halloween Door Tool v5.8 Loaded Successfully!")
