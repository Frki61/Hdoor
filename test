local function preparePrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then return end
	if originalHoldDurations[prompt] == nil then originalHoldDurations[prompt] = prompt.HoldDuration end
	prompt.Enabled = true
	prompt.RequiresLineOfSight = false
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	prompt.ClickablePrompt = true
	if prompt.MaxActivationDistance < 35 then prompt.MaxActivationDistance = 35 end

	if not State.useSmartHoldMode or (State.isPromptActive and not State.isCollectingNow) then
		prompt.HoldDuration = 0
	else
		local orig = originalHoldDurations[prompt]
		if orig and orig > 0 then prompt.HoldDuration = orig end
	end
end

local function applyPromptMod(prompt)
	if not prompt:IsA("ProximityPrompt") then return end
	if not getDoorRootFromDescendant(prompt) then return end
	preparePrompt(prompt)
	if not promptConnections[prompt] then
		local conns = {}
		table.insert(conns, prompt:GetPropertyChangedSignal("RequiresLineOfSight"):Connect(function()
			if (State.isPromptActive or State.isCollectingNow) and prompt.Parent and prompt.RequiresLineOfSight then
				prompt.RequiresLineOfSight = false
			end
		end))
		table.insert(conns, prompt.AncestryChanged:Connect(function(_, parent)
			if not parent and promptConnections[prompt] then
				for _, c in ipairs(promptConnections[prompt]) do pcall(function() c:Disconnect() end) end
				promptConnections[prompt] = nil
			end
		end))
		promptConnections[prompt] = conns
	end
end

