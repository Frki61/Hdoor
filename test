local function isDoorMovingOrJittering(doorPart)
	if not doorPart or not doorPart.Parent then return false end
	if doorPart.AssemblyLinearVelocity and doorPart.AssemblyLinearVelocity.Magnitude > Config.JITTER_VELOCITY_THRESHOLD then
		return true
	end
	local p0 = doorPart.Position
	task.wait(0.03)
	if not doorPart or not doorPart.Parent then return false end
	local p1 = doorPart.Position
	return (p1 - p0).Magnitude > 0.65
end

local function attachAndAttackDoor(door, doorPart, statusCallback)
	local char, hrp, hum = getAliveCharacter()
	if not char or not hrp or not hum or not doorPart or not doorPart.Parent then return false end

	hum.PlatformStand = true
	local camera = Workspace.CurrentCamera

	if statusCallback then statusCallback("⚔️ Jitter Door Locked: Attacking...") end

	local attachConnection = RunService.RenderStepped:Connect(function()
		local _, liveHrp = getAliveCharacter()
		if not liveHrp or not doorPart or not doorPart.Parent then return end

		local targetCFrame = doorPart.CFrame * CFrame.new(0, 0, 2.2) * CFrame.Angles(0, math.pi, 0)
		liveHrp.CFrame = targetCFrame
		liveHrp.AssemblyLinearVelocity = Vector3.zero
		liveHrp.AssemblyAngularVelocity = Vector3.zero

		if camera then
			camera.CFrame = CFrame.lookAt(liveHrp.Position + Vector3.new(0, 2, 0), doorPart.Position)
		end
	end)

	local attackStart = os.clock()
	local maxTimeout = 10.0

	while State.isAutoCollectActive and (os.clock() - attackStart) < maxTimeout do
		if not door or not door.Parent or not door:IsDescendantOf(Workspace) then break end
		if not doorPart or not doorPart.Parent then break end

		for _, desc in ipairs(door:GetDescendants()) do
