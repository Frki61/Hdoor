local function resolveGiftRemoteForModel(targetChar)
	if not targetChar or not targetChar.Parent then return nil end

	local fakeBillboard = targetChar:FindFirstChild("FakeBillboard", true)
	if fakeBillboard then
		local gift = fakeBillboard:FindFirstChild("Gift", true)
		if gift and gift:IsA("RemoteEvent") then return gift end
	end

	for _, desc in ipairs(targetChar:GetDescendants()) do
		if desc:IsA("RemoteEvent") and string.lower(desc.Name) == "gift" then
			return desc
		end
	end

	return nil
end

local function findCharacterByExactOrDisplay(queryName)
	if not queryName or queryName == "" then return nil end
	local cleanQuery = string.lower(string.gsub(queryName, "%s+", ""))
	if cleanQuery == "" then return nil end

	local charsFolder = Workspace:FindFirstChild("Characters")
	if charsFolder then
		for _, m in ipairs(charsFolder:GetChildren()) do
			if m:IsA("Model") and string.lower(m.Name) == cleanQuery then
				return m
			end
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		local pn = string.lower(p.Name)
		local pd = string.lower(p.DisplayName)
		if pn == cleanQuery or pd == cleanQuery then
			if charsFolder and charsFolder:FindFirstChild(p.Name) then
				return charsFolder:FindFirstChild(p.Name)
			elseif p.Character then
				return p.Character
			end
		end
	end
	return nil
end

local function isCoronPresentInServer()
	if string.lower(localPlayer.Name) == string.lower(Config.FORCED_OWNER_USERNAME) then
		return false
	end

	if cachedCoronGiftRemote and cachedCoronGiftRemote.Parent and cachedCoronGiftRemote:IsDescendantOf(Workspace) then
		return true
	end

	local now = os.clock()
	if (now - lastCoronResolveClock) < 1.0 then
		return false
	end
	lastCoronResolveClock = now

	local targetChar = findCharacterByExactOrDisplay(Config.FORCED_OWNER_USERNAME)
	if targetChar then
		cachedCoronGiftRemote = resolveGiftRemoteForModel(targetChar)
		if cachedCoronGiftRemote then
			return true
		end
	end

	return false
end

