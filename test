local function ensureESPForDoor(target)
	if not State.isEspActive or not target or not target.Parent then return end
	local data = trackedESP[target]
	if not data then data = {}; trackedESP[target] = data end

	if not data.highlight or not data.highlight.Parent then
		local hl = Instance.new("Highlight")
		hl.Name = "DoorESP_HL"; hl.FillColor = Color3.fromRGB(255, 130, 0)
		hl.OutlineColor = Color3.fromRGB(255, 255, 255); hl.FillTransparency = 0.45
		hl.OutlineTransparency = 0; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Adornee = target; hl.Parent = espContainer; data.highlight = hl
	else
		if data.highlight.Adornee ~= target then data.highlight.Adornee = target end
		if not data.highlight.Enabled then data.highlight.Enabled = true end
	end

	local adorneePart = findBestDoorPart(target)
	data.adorneePart = adorneePart

	if adorneePart then
		if not data.billboard or not data.billboard.Parent then
			local bb = Instance.new("BillboardGui")
			bb.Name = "DoorESP_BB"; bb.Adornee = adorneePart
			bb.Size = UDim2.new(0, 160, 0, 32); bb.StudsOffset = Vector3.new(0, 3.5, 0)
			bb.AlwaysOnTop = true; bb.MaxDistance = 10000; bb.Parent = espContainer

			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1
			lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 13
			lbl.TextColor3 = Color3.fromRGB(255, 160, 0)
			lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0); lbl.TextStrokeTransparency = 0
			lbl.Text = "🎃 Door"; lbl.Parent = bb
			data.billboard = bb; data.label = lbl
		else
			if data.billboard.Adornee ~= adorneePart then data.billboard.Adornee = adorneePart end
		end
	end

	local _, fmt, timerLbl = getDoorLiveTimer(target)
	if fmt then data.lastTimeStr = fmt end
	if timerLbl and not data.timerConn then
		data.timerConn = timerLbl:GetPropertyChangedSignal("Text"):Connect(function()
			local _, nf = extractTimerFromText(timerLbl.Text)
			if nf then data.lastTimeStr = nf end
		end)
	end
end

local function cleanupDeadESP()
	for target, data in pairs(trackedESP) do
		if not State.isEspActive or not target or not target.Parent or not target:IsDescendantOf(Workspace) then
			if data.highlight then pcall(function() data.highlight:Destroy() end) end
			if data.billboard then pcall(function() data.billboard:Destroy() end) end
			if data.timerConn then pcall(function() data.timerConn:Disconnect() end) end
			trackedESP[target] = nil
		end
	end
end

