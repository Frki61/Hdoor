local function onDescendantAdded(desc)
	if not desc then return end
	if desc:IsA("ProximityPrompt") then
		if originalHoldDurations[desc] == nil then
			originalHoldDurations[desc] = desc.HoldDuration
		end
		if State.isPromptActive and not State.isCollectingNow then
			task.defer(applyPromptMod, desc)
		end
		if State.isEspActive then
			local root = getDoorRootFromDescendant(desc)
			if root then task.defer(ensureESPForDoor, root) end
		end
	elseif desc.Name == "HalloweenDoor" then
		if State.isEspActive then
			task.defer(ensureESPForDoor, desc)
		end
	end
end

local effectsFolder = getEffectsFolder()
if effectsFolder then
	local effConn = effectsFolder.DescendantAdded:Connect(onDescendantAdded)
	table.insert(globalConnections, effConn)
end

